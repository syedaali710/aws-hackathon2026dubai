<mxfile host="app.diagrams.net" agent="CareBridge generator" version="22.0.0" type="device">
  <diagram name="CareBridge UAE Architecture" id="carebridge-architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;CareBridge UAE — Solution Architecture&lt;/b&gt; (AWS Agentic AI Hackathon · Health Companion track · prototype)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=17;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="patient" value="" style="shape=umlActor;verticalLabelPosition=bottom;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="125" y="62" width="36" height="62" as="geometry" /></mxCell>
        <mxCell id="patientlbl" value="&lt;b&gt;Patient / Gary&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="170" y="80" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="webui" value="&lt;b&gt;Bilingual English–Arabic / RTL&lt;br&gt;Accessible Web UI&lt;/b&gt;&lt;div style='text-align:left;margin-top:6px'&gt;• Symptom input (EN / AR)&lt;br&gt;• Provider options + booking confirmation&lt;br&gt;• Consent-controlled care snapshot card&lt;br&gt;• English clinician handoff&lt;br&gt;• Arabic RTL patient/caregiver summary&lt;br&gt;• Activity timeline&lt;br&gt;• Synthetic-data / simulated-provider notice&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="245" height="200" as="geometry" /></mxCell>
        <mxCell id="events" value="&lt;b&gt;Non-sensitive activity events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;(shown in UI timeline — never contain symptoms, medications, allergies, diagnoses, patient IDs or history)&lt;/span&gt;&lt;div style='text-align:left;margin-top:5px'&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;TRIAGE_GUIDANCE_RETRIEVED&lt;br&gt;RELEVANT_CONTEXT_RETRIEVED&lt;br&gt;MEDICATION_REFERENCE_CHECKED&lt;br&gt;PROVIDER_OPTIONS_FOUND&lt;br&gt;BOOKING_AWAITING_CONFIRMATION&lt;br&gt;MOCK_BOOKING_CONFIRMED&lt;br&gt;VISIT_SUMMARY_GENERATED&lt;br&gt;URGENT_ESCALATION_SHOWN&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10.5;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="245" height="225" as="geometry" /></mxCell>
        <mxCell id="oos" value="&lt;b&gt;Explicitly out of scope&lt;/b&gt;&lt;div style='text-align:left;margin-top:5px'&gt;• Authentication / identity verification&lt;br&gt;• Real EMR, UAE PASS, Riayati, NABIDH, Malaffi, DHA, MOHAP integration&lt;br&gt;• Real booking, pharmacy or insurer systems&lt;br&gt;• OCR / medical-document storage&lt;br&gt;• New patient database or schema&lt;br&gt;• Multiple runtime agents&lt;br&gt;• Real patient health information&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="635" width="245" height="215" as="geometry" /></mxCell>
        <mxCell id="aws" value="&lt;b&gt;AWS Cloud — us-west-2&lt;/b&gt; (hackathon workshop account)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232f3e;fontSize=12;align=left;verticalAlign=top;dashed=1;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="1140" height="985" as="geometry" /></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Amazon Bedrock AgentCore Runtime&lt;/b&gt; — &lt;b&gt;CareBridgeHealthAgent&lt;/b&gt; (single Strands orchestration agent)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="740" height="510" as="geometry" /></mxCell>
        <mxCell id="loop" value="&lt;b&gt;Strands agent loop&lt;/b&gt; — reason → call tool → observe result → repeat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10.5;align=center;verticalAlign=top;dashed=1;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="365" y="125" width="490" height="460" as="geometry" /></mxCell>
        <mxCell id="s1" value="① Clarify — at most one essential question (only if needed)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s2" value="② Retrieve triage / referral guidance (Knowledge Base)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="194" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s3" value="③ Retrieve minimum-necessary patient context" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="228" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s4" value="④ Medication-reference check → flag for clinician / pharmacist" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="262" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="dec" value="Guidance indicates&lt;br&gt;urgent / emergency?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="298" width="160" height="62" as="geometry" /></mxCell>
        <mxCell id="urgent" value="&lt;b&gt;Urgent / emergency escalation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;no routine booking; loop ends&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="712" y="302" width="132" height="56" as="geometry" /></mxCell>
        <mxCell id="s5" value="⑤ Search mock providers (specialty · location · availability)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="376" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s6" value="⑥ Present options → ⏸ wait for explicit user confirmation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s7" value="⑦ Mock booking — only after confirmation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="444" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s8" value="⑧ ⏸ Patient reviews consent snapshot (minimum necessary)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="478" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="s9" value="⑨ Generate EN clinician handoff + AR RTL summary" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="512" width="320" height="26" as="geometry" /></mxCell>
        <mxCell id="refuse" value="&lt;b&gt;Refusal path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Diagnosis, medication, dose, prescription or treatment request → brief refusal + safe navigation offer + not-medical-advice note&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="712" y="410" width="132" height="128" as="geometry" /></mxCell>
        <mxCell id="memctx" value="&lt;span style=&quot;font-size:9px&quot;&gt;⏸ = human-in-the-loop pause: the loop returns to the UI and resumes on the patient's next message (same session)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="548" width="460" height="26" as="geometry" /></mxCell>
        <mxCell id="prompt" value="&lt;b&gt;CareBridge system prompt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;role, allowed actions, prohibited actions, tool order, escalation &amp;amp; refusal rules&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="205" height="95" as="geometry" /></mxCell>
        <mxCell id="guard" value="&lt;b&gt;Amazon Bedrock Guardrails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;shared baseline + track denied topics:&lt;br&gt;diagnosis · prescribing · medication dosing · treatment&lt;br&gt;applied to model calls&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="205" height="115" as="geometry" /></mxCell>
        <mxCell id="model" value="&lt;b&gt;Amazon Bedrock&lt;br&gt;foundation model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;as configured in the starter kit&lt;br&gt;(toolkit default: Claude Sonnet 4.6)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="375" width="205" height="110" as="geometry" /></mxCell>
        <mxCell id="memory" value="&lt;b&gt;AgentCore Memory&lt;/b&gt;&lt;div style='text-align:left;margin-top:4px'&gt;Persist ONLY:&lt;br&gt;• language preference&lt;br&gt;• consent preference&lt;br&gt;• appointment reference / status&lt;br&gt;• next action&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;&lt;i&gt;Never persisted: symptoms, history, medications, allergies, document text, full summaries, interaction details&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="90" width="345" height="150" as="geometry" /></mxCell>
        <mxCell id="obs" value="&lt;b&gt;AgentCore Observability → Amazon CloudWatch&lt;/b&gt;&lt;br&gt;Redacted operational traces only&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;no PHI in logs, trace attributes, errors or activity events&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="345" height="105" as="geometry" /></mxCell>
        <mxCell id="ssm" value="&lt;b&gt;AWS Systems Manager Parameter Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;resource identifiers read at runtime — never hard-coded&lt;/span&gt;&lt;div style='text-align:left;margin-top:5px'&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;/app/workshop/health-companion/patients-table&lt;br&gt;/app/workshop/health-companion/providers-table&lt;br&gt;/app/workshop/health-companion/knowledge-base-id&lt;br&gt;/app/workshop/guardrails/guardrail-id&lt;br&gt;/app/workshop/lambda/execution-role-arn&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="385" width="345" height="215" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt; — exposes the tools to the agent as MCP tools (Gateway / Lambda pattern)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="625" width="1105" height="44" as="geometry" /></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Tools&lt;/b&gt; — starter-kit mock tool APIs (AWS Lambda) + Knowledge Base retrieval" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;dashed=1;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="690" width="1105" height="165" as="geometry" /></mxCell>
        <mxCell id="t1" value="&lt;b&gt;Patient Context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;get_patient_profile(patient_id)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;read-only · minimum-necessary fields&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="t2" value="&lt;b&gt;Triage &amp;amp; Referral&lt;br&gt;KB Retrieval&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;approved guidance only; never turned into diagnosis&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="546" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Medication Interaction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;check_medication_interactions(medications)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;flags for clinician / pharmacist only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="726" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="t4" value="&lt;b&gt;Provider Search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;search_providers(specialty, location, availability)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;mock availability&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="906" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="t5" value="&lt;b&gt;Mock Appointment Booking&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;book_appointment(provider_id, patient_id, date)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;state-changing · only after explicit confirmation&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1086" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="t6" value="&lt;b&gt;Visit Summary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9px;overflow-wrap:anywhere&quot;&gt;generate_visit_summary(patient_id, symptoms, duration)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;consented facts, timeline, questions only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1266" y="725" width="172" height="115" as="geometry" /></mxCell>
        <mxCell id="ddbp" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;Synthetic patients table" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="362" y="900" width="180" height="105" as="geometry" /></mxCell>
        <mxCell id="kb" value="&lt;b&gt;Amazon Bedrock&lt;br&gt;Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;triage · referral · medication-reference guidance&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="632" y="900" width="190" height="105" as="geometry" /></mxCell>
        <mxCell id="ddbv" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;Mock providers table" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=10.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="902" y="900" width="180" height="105" as="geometry" /></mxCell>
        <mxCell id="synth" value="&lt;b&gt;Synthetic data only&lt;/b&gt;&lt;br&gt;Seeded starter-kit patients and providers · simulated provider and booking tools · no real health records" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10.5;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="905" width="345" height="95" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt; &amp;nbsp; ── request / response &amp;nbsp;&amp;nbsp; - - - data access &amp;nbsp;&amp;nbsp; &lt;span style='background:#ffe6cc;padding:0 4px'&gt;⏸ orange&lt;/span&gt; human-in-the-loop pause &amp;nbsp;&amp;nbsp; &lt;span style='background:#f8cecc;padding:0 4px'&gt;red&lt;/span&gt; safety boundary" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1055" width="1420" height="28" as="geometry" /></mxCell>
        <mxCell id="footer" value="&lt;i&gt;Prototype uses synthetic data and simulated provider tools. CareBridge UAE supports healthcare navigation; it does not diagnose, prescribe, or replace clinicians.&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="1420" height="48" as="geometry" /></mxCell>
        <mxCell id="lbl_in" value="&lt;span style=&quot;font-size:9px&quot;&gt;prompt · confirmations (session)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="266" y="196" width="84" height="36" as="geometry" /></mxCell>
        <mxCell id="lbl_out" value="&lt;span style=&quot;font-size:9px&quot;&gt;response · activity events · handoffs&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="266" y="303" width="84" height="44" as="geometry" /></mxCell>
        <mxCell id="lbl_no" value="&lt;span style=&quot;font-size:9px&quot;&gt;no&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="546" y="360" width="30" height="14" as="geometry" /></mxCell>
        <mxCell id="lbl_mcp" value="&lt;span style=&quot;font-size:9px&quot;&gt;MCP tool calls / results&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="618" y="596" width="140" height="20" as="geometry" /></mxCell>
        <mxCell id="e_pu" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="143" y="124" as="sourcePoint" /><mxPoint x="143" y="160" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_ui_rt" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="235" as="sourcePoint" /><mxPoint x="350" y="235" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_rt_ui" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="300" as="sourcePoint" /><mxPoint x="265" y="300" as="targetPoint" /></mxGeometry></mxCell>
