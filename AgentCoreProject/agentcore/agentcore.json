{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "AgentCoreProject",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "AgentCoreProject"
  },
  "runtimes": [
    {
      "name": "HealthAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/HealthAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
        },
        {
          "name": "GUARDRAIL_ID",
          "value": "ftg7rghqnrf5"
        },
        {
          "name": "GUARDRAIL_VERSION",
          "value": "2"
        },
        {
          "name": "GATEWAY_SCOPE",
          "value": "workshop-gateway/invoke"
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "health_memory",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "workshop-gateway-oauth",
      "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_plwuj5fNK/.well-known/openid-configuration",
      "vendor": "CustomOauth2",
      "managed": true,
      "usage": "inbound"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "workshop-gateway",
      "protocolType": "MCP",
      "description": "Gateway for workshop-gateway",
      "targets": [
        {
          "name": "health",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:233337493171:function:workshop-health-tools",
            "toolSchemaFile": "tool_specs/health.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_plwuj5fNK/.well-known/openid-configuration",
          "allowedClients": [
            "3a9n6tnpqj6ruu4gasgr8jsms4"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}